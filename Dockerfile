# --- build statis ---
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_FB_APP_ID
ARG NEXT_PUBLIC_WA_CONFIG_ID
ARG NEXT_PUBLIC_WA_ES_VERSION=v5
ARG NEXT_PUBLIC_GRAPH_VERSION=v26.0
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_PUBLIC_FB_APP_ID=$NEXT_PUBLIC_FB_APP_ID NEXT_PUBLIC_WA_CONFIG_ID=$NEXT_PUBLIC_WA_CONFIG_ID \
    NEXT_PUBLIC_WA_ES_VERSION=$NEXT_PUBLIC_WA_ES_VERSION NEXT_PUBLIC_GRAPH_VERSION=$NEXT_PUBLIC_GRAPH_VERSION
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# --- sajikan dengan nginx ---
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html
EXPOSE 80
